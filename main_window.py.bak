    # DEVICES PAGE
    # ==================================================

    def create_devices_page(self):

        page, layout = self.make_page_frame()

        top, top_layout = self.make_card(
            "Connected Devices",
            "Devices discovered by the current network scan."
        )

        toolbar = QHBoxLayout()

        self.device_search = QLineEdit()
        self.device_search.setPlaceholderText("Search devices...")
        self.device_search.setMinimumHeight(36)
        self.device_search.setStyleSheet(
            """
            QLineEdit {
                background:#F8FBEF;
                border:1px solid #DCE9E1;
                border-radius:10px;
                padding:7px 10px;
                color:#173A40;
            }
            """
        )
        self.device_search.textChanged.connect(self.filter_devices_table)
        toolbar.addWidget(self.device_search, 1)

        refresh_devices = QPushButton("⟳  Refresh")
        refresh_devices.setMinimumHeight(36)
        refresh_devices.setCursor(Qt.PointingHandCursor)
        refresh_devices.clicked.connect(self.refresh_network)
        refresh_devices.setStyleSheet(
            """
            QPushButton {
                background:#087B55;
                color:white;
                border:none;
                border-radius:10px;
                padding:7px 14px;
                font-weight:800;
            }
            """
        )
        toolbar.addWidget(refresh_devices)

        top_layout.addLayout(toolbar)

        self.device_table = QTableWidget()
        self.device_table.setColumnCount(6)
        self.device_table.setHorizontalHeaderLabels(
            ["Device", "IP Address", "MAC Address", "Role", "Signal", "Status"]
        )
        self.device_table.setEditTriggers(QTableWidget.NoEditTriggers)
        self.device_table.setSelectionBehavior(QTableWidget.SelectRows)
        self.device_table.setAlternatingRowColors(True)
        self.device_table.horizontalHeader().setStretchLastSection(True)
        self.device_table.setStyleSheet(
            """
            QTableWidget {
                background:#FFFDF7;
                alternate-background-color:#F5FAF5;
                border:1px solid #DCE9E1;
                border-radius:12px;
                gridline-color:#E5EEE8;
                color:#173A40;
            }
            QHeaderView::section {
                background:#D8E8E3;
                color:#087B55;
                padding:9px;
                border:none;
                font-weight:900;
            }
            QTableWidget::item:selected {
                background:#59E3AD;
                color:#173A40;
            }
            """
        )

        top_layout.addWidget(self.device_table, 1)
        layout.addWidget(top, 1)

        return page

    def filter_devices_table(self, value):

        if not hasattr(self, "device_table"):
            return

        query = value.strip().lower()

        for row in range(self.device_table.rowCount()):
            visible = not query

            if query:
                for col in range(self.device_table.columnCount()):
                    item = self.device_table.item(row, col)
                    if item and query in item.text().lower():
                        visible = True
                        break

            self.device_table.setRowHidden(row, not visible)

