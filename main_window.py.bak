    def make_page_frame(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(2, 2, 2, 2)
        layout.setSpacing(10)
        page.setStyleSheet("background:transparent;")
        return page, layout



    def make_card(self, title, subtitle=""):
        frame = QFrame()
        frame.setStyleSheet("""
            QFrame {
                background:#F9FAF5;
                border:1px solid #C7D3CF;
                border-radius:20px;
            }
        """)

        layout = QVBoxLayout(frame)
        layout.setContentsMargins(19, 16, 19, 16)
        layout.setSpacing(7)

        heading = QLabel(title)
        heading.setStyleSheet(
            "font-size:17px;font-weight:900;color:#173A40;"
        )
        layout.addWidget(heading)

        if subtitle:
            sub = QLabel(subtitle)
            sub.setWordWrap(True)
            sub.setStyleSheet(
                "font-size:10px;color:#667A77;padding-bottom:3px;"
            )
            layout.addWidget(sub)

        return frame, layout


    def toggle_network_summary(self):

        expanded = self.summary_toggle.isChecked()

        self.summary_scroll.setVisible(expanded)

        if expanded:
            self.summary_toggle.setText("▾   Network Summary")
        else:
            self.summary_toggle.setText("▸   Network Summary")

    def toggle_sidebar(self):

        collapsed = self.sidebar.width() > 100

        if collapsed:
            self.sidebar.setFixedWidth(70)
            self.sidebar_brand.setVisible(False)
            self.sidebar_brand_sub.setVisible(False)
            self.summary_toggle.setVisible(False)
            self.summary_scroll.setVisible(False)
            self.sidebar_status.setText("●")

            icons = ["⌂", "◉", "▣", "⌁", "◌", "⚙"]
            names = [
                "Network Topology",
                "Live Scan",
                "Devices",
                "Signal Advisor",
                "Analytics",
                "Settings",
            ]

            for button, icon, name in zip(
                self.nav_buttons, icons, names
            ):
                button.setText(icon)
                button.setToolTip(name)

        else:
            self.sidebar.setFixedWidth(224)
            self.sidebar_brand.setVisible(True)
            self.sidebar_brand_sub.setVisible(True)
            self.summary_toggle.setVisible(True)
            self.summary_scroll.setVisible(
                self.summary_toggle.isChecked()
            )
            self.sidebar_status.setText("●  SYSTEM READY")

            icons = ["⌂", "◉", "▣", "⌁", "◌", "⚙"]
            names = [
                "Network Topology",
                "Live Scan",
                "Devices",
                "Signal Advisor",
                "Analytics",
                "Settings",
            ]

            for button, icon, name in zip(
                self.nav_buttons, icons, names
            ):
                button.setText(f"{icon}   {name}")
                button.setToolTip("")

    def navigate_to(self, index):

        if index < 0 or index >= self.pages.count():
            return

        self.pages.setCurrentIndex(index)

        for i, button in enumerate(self.nav_buttons):
            button.setChecked(i == index)

        titles = [
            ("Network Topology", "Real-time network connectivity visualization"),
            ("Live Scan", "Continuous discovery and network status"),
            ("Devices", "Connected devices discovered on the network"),
            ("Signal Advisor", "Signal strength, distance and movement guidance"),
            ("Analytics", "Network performance and live measurements"),
            ("Settings", "Waveium appearance, scanning and behavior"),
        ]

        title, subtitle = titles[index]
        self.page_title.setText(title)
        self.page_subtitle.setText(subtitle)
        self.details_header_button.setVisible(index == 0)

        if index == 3:
            self.update_advisor_page()
        elif index == 4:
            self.update_analytics_page()
        elif index == 2:
            self.update_devices_page()
        elif index == 1:
            self.update_live_scan_page()

    def create_topology_page(self):

        page, main_layout = self.make_page_frame()

        network_bar = QFrame()
        network_layout = QHBoxLayout(network_bar)
        network_layout.setContentsMargins(12, 7, 12, 7)
        network_layout.setSpacing(14)

        wifi = self.network_data.get("wifi", {})

        self.ssid_label = QLabel(
            f"SSID: {wifi.get('ssid') or 'N/A'}"
        )
        self.bssid_label = QLabel(
            f"BSSID: {wifi.get('bssid') or 'N/A'}"
        )
        self.band_label = QLabel(
            f"Band: {wifi.get('band') or 'N/A'}"
        )
        self.channel_label = QLabel(
            f"Channel: {wifi.get('channel') or 'N/A'}"
        )
        self.signal_label = QLabel(
            f"Signal: {wifi.get('signal_percent') if wifi.get('signal_percent') is not None else 'N/A'}%"
        )

        for label in [
            self.ssid_label,
            self.bssid_label,
            self.band_label,
            self.channel_label,
            self.signal_label,
        ]:
            label.setStyleSheet(
                "font-size:12px; color:#705D66; font-weight:600;"
            )
            network_layout.addWidget(label)

        network_layout.addStretch()

        device_count = len(self.network_data.get("devices", []))
        self.count_label = QLabel(
            f"●  {device_count + 1} Devices Connected"
        )
        self.count_label.setStyleSheet(
            "color:#087B55; font-weight:700;"
        )
        network_layout.addWidget(self.count_label)

        main_layout.addWidget(network_bar)

        content = QHBoxLayout()
        content.setSpacing(12)

        # Network Summary is available from the left sidebar submenu.
        graph_frame = QFrame()
        graph_frame.setStyleSheet(
            """
            QFrame {
                background:#FFFDF7;
                border:1px solid #DCE9E1;
                border-radius:18px;
            }
            """
        )

        graph_layout = QVBoxLayout(graph_frame)
        graph_layout.setContentsMargins(10, 8, 10, 10)
        graph_layout.setSpacing(6)

        graph_title_row = QHBoxLayout()

        graph_title = QLabel("Network Topology")
        graph_title.setStyleSheet(
            """
            font-size:24px;
            font-weight:800;
            color:#173A40;
            padding:5px;
            """
        )
        graph_title_row.addWidget(graph_title)
        graph_title_row.addStretch()

        graph_hint = QLabel(
            "Real-time signal • distance • device connectivity"
        )
        graph_hint.setStyleSheet(
            "color:#53696A; font-size:12px;"
        )
        graph_title_row.addWidget(graph_hint)

        graph_layout.addLayout(graph_title_row)

        self.graph_canvas = WaveiumGraphCanvas(self.graph)
        self.graph_canvas.device_selected.connect(self.device_selected)
        self.graph_canvas.setMinimumSize(0, 0)
        self.graph_canvas.setSizePolicy(
            QSizePolicy.Expanding,
            QSizePolicy.Expanding
        )
        graph_layout.addWidget(self.graph_canvas, 1)

        flow = QFrame()
        flow.setStyleSheet(
            """
            QFrame {
                background:#EAF8EC;
                border:1px solid #D7EADF;
                border-radius:12px;
            }
            """
        )

        flow_layout = QHBoxLayout(flow)
        flow_layout.setContentsMargins(10, 6, 10, 6)

        flow_title = QLabel("Data Flow (Live)")
        flow_title.setStyleSheet(
            "font-weight:700; color:#5D2343;"
        )
        flow_layout.addWidget(flow_title)
        flow_layout.addStretch()

        self.flow_download = QLabel("Download  — Mbps")
        self.flow_upload = QLabel("Upload  — Mbps")

        for lab in [self.flow_download, self.flow_upload]:
            lab.setStyleSheet(
                "font-weight:700; color:#087B55;"
            )
            flow_layout.addWidget(lab)

        graph_layout.addWidget(flow)
        content.addWidget(graph_frame, 1)

        right_holder = QWidget()
        right_holder.setMinimumWidth(270)
        right_holder.setMaximumWidth(330)

        right_holder_layout = QVBoxLayout(right_holder)
        right_holder_layout.setContentsMargins(0, 0, 0, 0)
        right_holder_layout.setSpacing(8)

        details_header = QHBoxLayout()

        details_title = QLabel("DEVICE DETAILS")
        details_title.setStyleSheet(
            "font-size:14px; font-weight:800; color:#173A40;"
        )
        details_header.addWidget(details_title)
        details_header.addStretch()

        self.details_close_button = QPushButton("✕")
        self.details_close_button.setFixedSize(34, 34)
        self.details_close_button.clicked.connect(self.toggle_details)
        details_header.addWidget(self.details_close_button)

        right_holder_layout.addLayout(details_header)

        right_content = QWidget()
        right_content.setStyleSheet("background: transparent;")

        right_content_layout = QVBoxLayout(right_content)
        right_content_layout.setContentsMargins(0, 0, 0, 0)
        right_content_layout.setSpacing(8)

        self.node_info_frame = self.create_node_panel()
        right_content_layout.addWidget(self.node_info_frame)

        self.signal_panel = self.create_signal_controls()
        right_content_layout.addWidget(self.signal_panel)

        right_content_layout.addStretch()

        self.right_scroll = self.make_scroll_area(
            right_content,
            width=330,
            outer=False,
        )

        right_holder_layout.addWidget(self.right_scroll, 1)
        self.right_holder = right_holder

        content.addWidget(right_holder, 0)
        main_layout.addLayout(content, 1)

        return page

    # ==================================================
    # LIVE SCAN PAGE
    # ==================================================

    def create_live_scan_page(self):

        page, layout = self.make_page_frame()

        stats = QHBoxLayout()
        stats.setSpacing(12)

        self.live_devices_metric = self.make_dashboard_metric(
            "DEVICES FOUND", "0", "Current network"
        )
        self.live_signal_metric = self.make_dashboard_metric(
            "LOCAL SIGNAL", "—", "Wi-Fi strength"
        )
        self.live_band_metric = self.make_dashboard_metric(
            "NETWORK BAND", "—", "Current adapter"
        )
        self.live_speed_metric = self.make_dashboard_metric(
            "LINK SPEED", "—", "RX / TX"
        )

        for card in [
            self.live_devices_metric,
            self.live_signal_metric,
            self.live_band_metric,
            self.live_speed_metric,
        ]:
            stats.addWidget(card)

        layout.addLayout(stats)

        card, card_layout = self.make_card(
            "Live Network Scan",
            "Waveium continuously refreshes the local network information."
        )

        self.live_scan_info = QLabel()
        self.live_scan_info.setWordWrap(True)
        self.live_scan_info.setStyleSheet(
            "font-size:12px; color:#425B5E; line-height:1.5;"
        )
        card_layout.addWidget(self.live_scan_info)

        scan_button = QPushButton("⟳  Scan Again")
        scan_button.setCursor(Qt.PointingHandCursor)
        scan_button.setMinimumHeight(38)
        scan_button.setStyleSheet(
            """
            QPushButton {
                background:#087B55;
                color:white;
                border:none;
                border-radius:11px;
                padding:8px 16px;
                font-weight:800;
            }
            QPushButton:hover {
                background:#0D5A4D;
            }
            """
        )
        scan_button.clicked.connect(self.refresh_network)
        card_layout.addWidget(scan_button, 0, Qt.AlignLeft)

        layout.addWidget(card)

        status, status_layout = self.make_card(
            "Scan Status",
            "Live network monitoring is running in the background."
        )
        self.live_scan_status = QLabel("●  LIVE SCAN ACTIVE")
        self.live_scan_status.setStyleSheet(
            "font-size:15px; font-weight:900; color:#087B55;"
        )
        status_layout.addWidget(self.live_scan_status)
        layout.addWidget(status)

        layout.addStretch()
        return page

    def make_dashboard_metric(self, title, value, subtitle):

        card = QFrame()
        card.setMinimumHeight(108)
        card.setStyleSheet(
            """
            QFrame {
                background:#FFFDF7;
                border:1px solid #DCE9E1;
                border-radius:17px;
            }
            """
        )

        layout = QVBoxLayout(card)
        layout.setContentsMargins(15, 13, 15, 12)
        layout.setSpacing(3)

        title_label = QLabel(title)
        title_label.setStyleSheet(
            "font-size:9px; color:#53696A; font-weight:900;"
        )
        layout.addWidget(title_label)

        value_label = QLabel(value)
        value_label.setStyleSheet(
            "font-size:23px; color:#173A40; font-weight:900;"
        )
        layout.addWidget(value_label)

        sub_label = QLabel(subtitle)
        sub_label.setStyleSheet(
            "font-size:9px; color:#53696A;"
        )
        layout.addWidget(sub_label)

        card.value_label = value_label
        return card

